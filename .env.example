# SAP CPI API base URL — include /api/v1 suffix
# e.g. https://mytenant.it-cpi015.cfapps.eu10-004.hana.ondemand.com/api/v1
API_BASE_URL=

# --- Auth option 1: Basic (S-User credentials) ---
API_USER=
API_PASS=

# --- Auth option 2: OAuth2 service key ---
API_OAUTH_CLIENT_ID=
API_OAUTH_CLIENT_SECRET=
API_OAUTH_TOKEN_URL=

# --- Optional: for send_test_message tool ---
# Base URL of your CPI tenant (no path), used to call iFlow HTTP endpoints
# e.g. https://mytenant.it-cpi015.cfapps.eu10-004.hana.ondemand.com
CPI_BASE_URL=
CPI_OAUTH_CLIENT_ID=
CPI_OAUTH_CLIENT_SECRET=
CPI_OAUTH_TOKEN_URL=
